# Copy this file to .env and fill it in. Never commit the real one.

# The Supabase project. For local testing, `npx supabase status` in backend/ prints both.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=paste-the-anon-or-publishable-key-here

# The app account this server signs in as. The assistant only ever sees this user's data.
FITNESS_EMAIL=you@example.com
FITNESS_PASSWORD=your-app-password
